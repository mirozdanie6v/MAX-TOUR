{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "max-tour-demo-v28",
  "main": "./src/worker-selection-v14.js",
  "compatibility_date": "2026-09-09",
  "vars": {
    "APP_ENV": "demo-v28",
    "APP_URL": "https://max-tour-demo.viiversion.com",
    "PUBLIC_ADMIN_DEMO": "true",
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "USD_RUB_RATE": "84.2569"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "max-tour-standalone-v28-db",
      "database_id": "REPLACED_BY_SHARED_DEPLOY"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TOUR_MEDIA",
      "bucket_name": "max-tour-demo-v28-media",
      "preview_bucket_name": "max-tour-demo-v28-media"
    }
  ]
}
